# CloudCLI UI Environment Configuration
# Only includes variables that are actually used in the code
#
# TIP: Run 'cloudcli status' to see where this file should be located
#      and to view your current configuration.
#
# Available CLI commands:
#   claude-code-ui    - Start the server (default)
#   cloudcli start    - Start the server
#   cloudcli status   - Show configuration and data locations
#   cloudcli help     - Show help information
#   cloudcli version  - Show version information

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# Backend server port (Express API + WebSocket server)
#API server
SERVER_PORT=3001
#Frontend port
VITE_PORT=5173

# Leave unset for same-origin/local assets. NAS publishing sets this to its CDN.
# VITE_STATIC_ASSET_BASE=https://assets.example.com/cloudcli/

# Leave unset when the browser should use the same origin (or Vite's proxy).
# VITE_API_ORIGIN=https://api.example.com

# Host/IP to bind servers to (default: 0.0.0.0 for all interfaces)
# Use 127.0.0.1 to restrict to localhost only
HOST=0.0.0.0

# Default Codex runtime for non-browser callers: app-server or sdk.
# The browser setting can select the runtime per request.
# CLOUDCLI_CODEX_RUNTIME_MODE=app-server

# Uncomment the following line if you have a custom claude cli path other than the default "claude"
# CLAUDE_CLI_PATH=claude

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# Path to the authentication database file
# This is where user credentials, API keys, and tokens are stored.
#
# To use a custom location:
# DATABASE_PATH=/path/to/your/custom/auth.db
#
# Claude Code context window size (maximum tokens per session). Fallback only:
# a Claude session uses the window the SDK reports for its model once a turn completes.
VITE_CONTEXT_WINDOW=160000
CONTEXT_WINDOW=160000


# Shared CloudCLI image conversion: originals stay intact; only smaller WebP variants are used.
# PNG is lossless, JPEG uses this quality; GIF/SVG/existing WebP stay unchanged.
# CLOUDCLI_IMAGE_WEBP_ENABLED=true
# CLOUDCLI_IMAGE_WEBP_QUALITY=85
# CLOUDCLI_IMAGE_WEBP_CACHE_BYTES=268435456
# Optional machine-local cache path (default: ~/.cloudcli/image-variants).
# CLOUDCLI_IMAGE_WEBP_CACHE_DIR=/path/to/local/image-variants

# Codex app-server history image context (defaults for new per-session policies).
# Current input, explicitly pinned images and one oversized latest image remain usable.
# CLOUDCLI_CODEX_IMAGE_CONTEXT_ENABLED=true
# CLOUDCLI_CODEX_HISTORY_IMAGES=3
# CLOUDCLI_CODEX_HISTORY_IMAGE_BYTES=1048576
# CLOUDCLI_CODEX_IMAGE_CACHE_BYTES=536870912
# CLOUDCLI_CODEX_PROXY_BODY_BYTES=67108864

# Codex app-server outbound HTTP body encoding, after image filtering/WebP.
# preserve keeps the incoming encoding; identity, zstd and gzip opt in explicitly.
# Bodies below 4 KiB or with no compression benefit are sent as identity.
# CLOUDCLI_CODEX_REQUEST_COMPRESSION=preserve
# Native zstd requires Node 22.15+. Missing zstd fails before sending unless gzip
# is confirmed for this exact upstream origin AFTER deploying the CPA gzip fix.
# This acknowledgement is local configuration, not an automatic capability probe.
# CLOUDCLI_CODEX_REQUEST_GZIP_ORIGINS=https://cpa.example.com
# Maximum compressed body in explicit modes; decoded JSON uses PROXY_BODY_BYTES.
# CLOUDCLI_CODEX_PROXY_COMPRESSED_BODY_BYTES=16777216
